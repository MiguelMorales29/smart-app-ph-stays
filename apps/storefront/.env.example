# Environment for the storefront build and server:
# development | preview | production
# (Next dev defaults to development; `next build` requires APP_ENV or NEXT_PUBLIC_APP_ENV.)
NEXT_PUBLIC_APP_ENV=development

# Data adapter:
# memory | http
# (APP_ENV=production requires DATA_SOURCE=http; `next dev` defaults to memory.)
NEXT_PUBLIC_DATA_SOURCE=memory

# Storefront origin prepended to /demo-media/... URLs in memory mode.
# Leave empty ("") for same-origin URLs so both laptop and phone over Wi-Fi work.
NEXT_PUBLIC_STOREFRONT_ORIGIN=

# Base URL for apps/api when DATA_SOURCE=http (used from Phase 11 onward).
NEXT_PUBLIC_API_BASE_URL=
