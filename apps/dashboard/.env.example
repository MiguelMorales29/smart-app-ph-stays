# Environment for the owner dashboard & super admin app:
# development | preview | production
# (Vite dev defaults to development; `vite build` requires APP_ENV or VITE_APP_ENV.)
VITE_APP_ENV=development

# Data adapter:
# memory | http
# (APP_ENV=production requires DATA_SOURCE=http; `vite dev` defaults to memory.)
VITE_DATA_SOURCE=memory

# Storefront origin used to resolve /demo-media/... URLs in memory mode.
VITE_STOREFRONT_ORIGIN=

# Base URL for apps/api when DATA_SOURCE=http (used from Phase 11 onward).
VITE_API_BASE_URL=
