{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@smartapp/ui/components/*": ["./src/components/*"],
      "@smartapp/ui/compositions/*": ["./src/compositions/*"],
      "@smartapp/ui/lib/*": ["./src/lib/*"],
      "@smartapp/ui/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/lib/**/*.ts",
    "src/hooks/**/*.ts",
    "src/compositions/**/*.ts",
    "src/compositions/**/*.tsx",
    "test/**/*.ts"
  ]
}
